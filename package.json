{
  "name": "regraft",
  "version": "0.1.10",
  "description": "Keep copied code up to date.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/treadiehq/regraft.git"
  },
  "homepage": "https://github.com/treadiehq/regraft#readme",
  "license": "FSL-1.1-MIT",
  "bin": {
    "regraft": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "schemas",
    "examples/session-graft",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm build:ui && tsup",
    "build:ui": "vite build --config web/vite.config.ts",
    "dev:ui": "vite --config web/vite.config.ts",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "prepack": "pnpm build",
    "build:binary": "bash scripts/build-release.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "diff": "^9.0.0",
    "highlight.js": "^11.11.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.9",
    "vue": "^3.5.40"
  }
}
